# ==================== 数据库 ====================
DATABASE_URL=postgresql+asyncpg://profit:profit123@localhost:5432/profit_forecast
DATABASE_URL_SYNC=postgresql+psycopg2://profit:profit123@localhost:5432/profit_forecast

# ==================== Redis ====================
REDIS_URL=redis://localhost:6379/0

# ==================== 数据源配置 ====================
# 接入方式: mock | starrocks | dataworks_api | maxcompute | database
DATAWORKS_ADAPTER=mock

# StarRocks 配置（推荐：直接查源数据，实时性强）
STARROCKS_HOST=your-starrocks-fe-host
STARROCKS_PORT=9030
STARROCKS_USER=your_username
STARROCKS_PASSWORD=your_password
STARROCKS_DATABASE=your_database

# DataWorks / MaxCompute 配置
DATAWORKS_ACCESS_KEY_ID=
DATAWORKS_ACCESS_KEY_SECRET=
DATAWORKS_PROJECT=
DATAWORKS_ENDPOINT=https://service.cn-shanghai.maxcompute.aliyun.com/api

# ==================== 应用配置 ====================
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ==================== 日志 ====================
LOG_LEVEL=DEBUG
LOG_FILE=logs/app.log
